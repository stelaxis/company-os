{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-book",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat"],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["BookGatekeeper", "BookMirrorStore"]
    }
  ],
  // Every five minutes. The handler is a no-op whenever the branch head is unchanged, which is
  // the common case: one conditional GitHub request, no tree walk and no blob reads.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "BOOK_DISPLAY_NAME": "Stelaxis Book",
    "BOOK_REPO_OWNER": "stelaxis",
    "BOOK_REPO_NAME": "stelaxis",
    "BOOK_REPO_BRANCH": "main",
    "BOOK_REPO_PATH": "docs/book"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
